# Scholarship portal (second container from the same image). Copy to .env.scholarship
# (gitignored) on the server, or .env.scholarship.local for local testing.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Its own secret (also keys opaque ticket ids and report tokens)
AUTH_SECRET=
AUTH_URL=https://<scholarship-host>
AUTH_TRUST_HOST=true
APP_URL=https://<scholarship-host>

DATABASE_URL=postgresql://sch_portal_app:CHANGE_ME@<db-host>:5432/scholarship
PGSSLMODE=disable
DEFAULT_TIMEZONE=Asia/Kolkata
NODE_ENV=production

PORTAL_KEY=scholarship
PORTAL_TITLE=Scholarship Query Tracker
ORG_LABEL=IITB ACR
SIGNIN_ORG_LABEL=IITB ACR
TEAM_LABEL=Scholarship
TEAM_SHORT=SC
MAILBOX_LABEL=Scholarship mailbox
PORTAL_DIRECTORY=[{"key":"it","name":"IT & Operations","url":"https://helpdesk.iitbacr.space"}]

# Scholarship n8n webhook paths (rendered with the team's webhook suffix)
N8N_CLOSE_WEBHOOK_URL=https://<n8n-host>/webhook/portal-ticket-closed-sch
N8N_ASSIGN_WEBHOOK_URL=https://<n8n-host>/webhook/portal-ticket-assigned-sch
N8N_STATUS_EVENT_WEBHOOK_URL=https://<n8n-host>/webhook/portal-ticket-status-event-sch
N8N_REPLY_WEBHOOK_URL=https://<n8n-host>/webhook/portal-ticket-reply-sch
N8N_REMIND_WEBHOOK_URL=https://<n8n-host>/webhook/portal-ticket-remind-sch
# Must equal system_config.portal_webhook_token in the scholarship database
N8N_WEBHOOK_TOKEN=
